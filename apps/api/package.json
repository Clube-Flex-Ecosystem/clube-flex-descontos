{
    "name": "@flex/api",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsup",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file=.env src/migrate.ts",
        "db:seed": "tsx --env-file=.env src/seed.ts"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "drizzle-orm": "^0.45.4",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "jose": "^6.2.12",
        "pg": "^8.23.1",
        "pino": "^10.4.0",
        "pino-http": "^11.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@flex/contracts": "workspace:*",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.19.2",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "drizzle-kit": "^0.31.11",
        "pino-pretty": "^13.2.0",
        "supertest": "^7.3.1",
        "tsup": "^8.5.1",
        "tsx": "^4.23.15",
        "vitest": "^5.0.3"
    }
}
