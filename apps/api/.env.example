NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flex:flex@localhost:5434/flex
# Segredo longo e aleatório para assinar os JWTs. Obrigatório em produção.
# AUTH_SECRET=
# Opcional: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=debug

# Origem do dashboard (CORS com credenciais e links de e-mail). Obrigatória em produção.
# DASHBOARD_ORIGIN=http://localhost:5173
# CATALOG_ORIGIN=http://localhost:4321
# Proxies confiáveis à frente da API (Coolify). 0 ignora X-Forwarded-For.
# TRUST_PROXY_HOPS=0
# E-mails transacionais (Resend). Sem chave, os códigos são entregues manualmente.
# RESEND_API_KEY=
# EMAIL_FROM="Clube Flex <nao-responda@exemplo.org>"
# Custo do bcrypt. O padrão é 12.
# BCRYPT_ROUNDS=12
# Obrigatória somente ao executar `pnpm --filter @flex/api db:seed`.
# SEED_SUPPORT_PASSWORD=
