---
import { Mail, MapPin, MessageSquare, Phone } from '@lucide/astro';
---

<footer
    class="bg-sidebar pb-8 pt-14 text-sidebar-foreground"
    data-surface="dark"
>
    <div class="mx-auto w-full max-w-300 px-4 md:px-8">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
            <div>
                <a
                    class="inline-flex min-h-11 items-center gap-0.5 font-display text-2xl font-bold font-stretch-110% tracking-[-0.02em] text-surface no-underline"
                    href="/"
                >
                    Parceiros<span class="text-brand-signal">+</span>
                </a>
                <p class="mt-3 max-w-[26em] text-sidebar-muted">
                    O Clube Flex é um clube de descontos. Não é plano de saúde.
                </p>
            </div>
            <nav aria-labelledby="f-nav">
                <h2
                    id="f-nav"
                    class="mb-2 text-caption font-semibold uppercase tracking-[0.08em] text-sidebar-muted"
                >
                    Navegação
                </h2>
                <ul>
                    <li>
                        <a
                            class="inline-flex min-h-11 items-center gap-2 text-surface no-underline decoration-brand-signal underline-offset-4 hover:underline"
                            href="/#sobre"
                        >
                            Sobre
                        </a>
                    </li>
                    <li>
                        <a
                            class="inline-flex min-h-11 items-center gap-2 text-surface no-underline decoration-brand-signal underline-offset-4 hover:underline"
                            href="/#parceiros"
                        >
                            Parceiros
                        </a>
                    </li>
                    <li>
                        <a
                            class="inline-flex min-h-11 items-center gap-2 text-surface no-underline decoration-brand-signal underline-offset-4 hover:underline"
                            href="/#como-funciona"
                        >
                            Como funciona
                        </a>
                    </li>
                    <li>
                        <button
                            class="inline-flex min-h-11 items-center gap-2 border-0 bg-transparent p-0 font-inherit text-surface decoration-brand-signal underline-offset-4 hover:underline"
                            type="button"
                            data-open-assistant="partner"
                        >
                            Quero ser parceiro
                        </button>
                    </li>
                </ul>
            </nav>
            <div>
                <h2 class="mb-2 text-caption font-semibold uppercase tracking-[0.08em] text-sidebar-muted">
                    Contato
                </h2>
                <ul>
                    <li>
                        <a
                            class="inline-flex min-h-11 items-center gap-2 text-surface no-underline decoration-brand-signal underline-offset-4 hover:underline"
                            href="tel:+552127029080"
                        >
                            <Phone
                                class="h-4 w-4 shrink-0"
                                aria-hidden="true"
                                stroke-width={1.75}
                            />
                            21 2702-9080
                        </a>
                    </li>
                    <li>
                        <a
                            class="inline-flex min-h-11 items-center gap-2 text-surface no-underline decoration-brand-signal underline-offset-4 hover:underline"
                            href="https://wa.me/552127029080"
                            target="_blank"
                            rel="noopener"
                        >
                            <MessageSquare
                                class="h-4 w-4 shrink-0"
                                aria-hidden="true"
                                stroke-width={1.75}
                            />
                            WhatsApp
                        </a>
                    </li>
                    <li>
                        <a
                            class="inline-flex min-h-11 items-center gap-2 text-surface no-underline decoration-brand-signal underline-offset-4 hover:underline"
                            href="mailto:comercial@flexcard.org.br"
                        >
                            <Mail
                                class="h-4 w-4 shrink-0"
                                aria-hidden="true"
                                stroke-width={1.75}
                            />
                            comercial@flexcard.org.br
                        </a>
                    </li>
                    <li>
                        <span class="inline-flex min-h-11 items-center gap-2 text-surface">
                            <MapPin
                                class="h-4 w-4 shrink-0"
                                aria-hidden="true"
                                stroke-width={1.75}
                            />
                            Rua Laureano Rosa 100, São Gonçalo, RJ
                        </span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-sidebar-raised pt-4 text-sm text-sidebar-muted">
            <span>© Clube Flex</span>
            <nav class="flex gap-4" aria-label="Documentos legais">
                <a
                    class="inline-flex min-h-11 items-center hover:text-surface"
                    href="/termos"
                >
                    Termos de uso
                </a>
                <a
                    class="inline-flex min-h-11 items-center hover:text-surface"
                    href="/privacidade"
                >
                    Privacidade
                </a>
            </nav>
        </div>
    </div>
</footer>
