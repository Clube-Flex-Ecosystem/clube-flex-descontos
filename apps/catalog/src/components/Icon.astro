---
import {
  CircleAlert,
  ArrowLeft,
  ArrowRight,
  BadgeCheck,
  BookOpen,
  CalendarDays,
  Check,
  ChevronDown,
  Heart,
  Info,
  Mail,
  MapPin,
  Menu,
  MessageSquare,
  Phone,
  Sparkles,
  Star,
} from '@lucide/astro';

interface Props {
  name: string;
  small?: boolean;
}

const { name, small = false } = Astro.props;
const icons = {
  heart: Heart,
  book: BookOpen,
  spark: Sparkles,
  badge: BadgeCheck,
  check: Check,
  calendar: CalendarDays,
  down: ChevronDown,
  pin: MapPin,
  phone: Phone,
  mail: Mail,
  menu: Menu,
  chat: MessageSquare,
  info: Info,
  left: ArrowLeft,
  right: ArrowRight,
  star: Star,
  alert: CircleAlert,
};
const Icon = icons[name as keyof typeof icons];
---

{Icon ? (
  <Icon
    class:list={['icon', { sm: small }]}
    aria-hidden="true"
    'stroke-width'={1.75}
  />
) : null}
