---
const ribbon = [
  'Saúde',
  'Educação',
  'Lazer',
  'Bem-estar',
  'Família',
  'Odontologia',
];
---

<div class="overflow-hidden py-4 pb-6" aria-hidden="true">
  <div class="mx-[-8px] overflow-hidden bg-sidebar py-[18px] text-sidebar-foreground [transform:rotate(-1.2deg)]">
    <div class="flex w-max animate-[marquee_40s_linear_infinite] motion-reduce:animate-none">
      {[...ribbon, ...ribbon].map((item) => (
        <span class="inline-flex items-center gap-10 whitespace-nowrap px-5 font-display text-[clamp(22px,4vw,32px)] font-medium after:text-[0.7em] after:text-gradient-to after:content-['✺']">
          {item}
        </span>
      ))}
    </div>
  </div>
</div>
