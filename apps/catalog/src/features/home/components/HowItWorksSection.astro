<section
  class="px-0 py-[72px]"
  id="como-funciona"
  aria-labelledby="steps-title"
>
  <div class="mx-auto w-full max-w-[1200px] px-4 md:px-8">
    <div class="max-w-[640px]">
      <p class="text-sm font-semibold uppercase tracking-[0.08em] text-accent-foreground">
        Como funciona
      </p>
      <h2
        class="mt-2 font-display text-[clamp(32px,6vw,48px)] font-semibold leading-[1.08] tracking-[-0.02em]"
        id="steps-title"
      >
        Em quatro passos.
      </h2>
    </div>
    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        'Cadastre-se',
        'Explore parceiros',
        'Use seu desconto',
        'Economize sempre',
      ].map((title, i) => (
        <li class="rounded-lg border border-border bg-background p-6 pt-7">
          <span class="font-display text-[56px] font-medium leading-none text-accent">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-3 text-xl font-semibold">{title}</h3>
          <p class="mt-2 leading-[1.5] text-foreground-soft">
            {i === 0
              ? 'Deixe seus dados e a equipe do Clube Flex entra em contato para apresentar os planos.'
              : i === 1
                ? 'Escolha seu plano no catálogo e veja os descontos disponíveis por categoria.'
                : i === 2
                  ? 'Siga as instruções de utilização de cada parceiro e apresente seu cupom quando houver.'
                  : 'Volte ao catálogo sempre que precisar e aproveite novas condições.'}
          </p>
          {i === 0 && (
            <button
              class="mt-[18px] inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-transparent bg-primary px-4 font-semibold text-white hover:bg-primary-hover"
              type="button"
              data-open-assistant="flex"
            >
              Quero ser Flex
            </button>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
