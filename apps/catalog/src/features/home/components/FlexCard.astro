---
interface Props {
    class?: string;
}
const { class: className = '' } = Astro.props;
---

<div
    class={`@container relative flex aspect-[85.6/54] flex-col justify-between overflow-hidden rounded-signature bg-linear-135 from-sidebar-raised via-sidebar to-sidebar px-[7%] py-[6%] text-surface shadow-signature before:pointer-events-none before:absolute before:inset-0 before:bg-linear-115 before:from-surface/15 before:to-transparent before:to-40% ${className}`}
    aria-hidden="true"
>
    <div class="relative z-10 flex items-start justify-between gap-2">
        <span class="font-display text-[7.5cqi] leading-none font-extrabold font-stretch-112% tracking-[-0.02em]">
            Clube Flex<span class="text-brand-signal">+</span>
        </span>
        <span class="rounded-full bg-surface/12 px-[0.9em] py-[0.5em] text-[4.2cqi] font-semibold tracking-[0.12em] uppercase">
            Família
        </span>
    </div>

    <div class="relative z-10 flex items-start justify-between gap-2">
        <div>
            <small class="block text-[3.6cqi] tracking-[0.06em] uppercase opacity-70">
                Titular
            </small>
            <b class="block text-[5cqi] font-semibold whitespace-nowrap">
                Nome do associado
            </b>
        </div>
    </div>
    <div class="absolute -right-[6%] -bottom-[10%] h-[70%] w-[46%] bg-[repeating-linear-gradient(-55deg,var(--color-brand-signal)_0_7%,transparent_7%_12%)] [clip-path:polygon(30%_100%,100%_0,100%_100%)]"></div>
</div>
