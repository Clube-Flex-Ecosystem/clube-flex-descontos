---
import type {
  PublicCategory,
  PublicPartner,
  PublicPlan,
} from '@flex/contracts';
import CatalogIsland from '../../catalog/components/CatalogIsland';

interface Props {
  plans: PublicPlan[];
  initialPlan?: PublicPlan;
  initialCategory?: string;
  initialCategories: PublicCategory[];
  initialPartners: PublicPartner[];
  initialInvalid?: boolean;
}

const {
  plans,
  initialPlan,
  initialCategory,
  initialCategories,
  initialPartners,
  initialInvalid,
} = Astro.props;
---

<section
  class="section catalog"
  id="parceiros"
  aria-labelledby="catalog-title"
>
  <div class="wrap">
    <CatalogIsland
      client:load
      plans={plans}
      initialPlan={initialPlan}
      initialCategory={initialCategory}
      initialCategories={initialCategories}
      initialPartners={initialPartners}
      initialInvalid={initialInvalid}
    />
  </div>
</section>
