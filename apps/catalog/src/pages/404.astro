---
import PublicLayout from '../layouts/PublicLayout.astro';
import { button } from '../components/ui/button';
Astro.response.status = 404;
---

<PublicLayout
    title="Página não encontrada — Clube Flex"
    description="A página solicitada não foi encontrada."
>
    <div class="mx-auto grid min-h-[50vh] w-full max-w-300 content-center justify-items-center gap-4 px-4 py-18 text-center md:px-8">
        <h1 class="font-display text-display font-stretch-110%">
            Página não encontrada
        </h1>
        <p class="text-muted-foreground">
            O endereço pode ter mudado ou não existe.
        </p>
        <a class={button('primary')} href="/">
            Voltar ao início
        </a>
    </div>
</PublicLayout>
