---
import PublicLayout from '../layouts/PublicLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
Astro.response.status = 404;
---

<PublicLayout
  title="Página não encontrada — Clube Flex"
  description="A página solicitada não foi encontrada."
>
  <Header />
  <main class="mx-auto grid min-h-[50vh] w-full max-w-[1200px] content-center gap-4 px-4 py-16 md:px-8">
    <h1>Página não encontrada</h1>
    <p>O endereço pode ter mudado ou não existe.</p>
    <a
      class="inline-flex min-h-12 w-fit items-center justify-center rounded-full bg-primary px-[22px] font-semibold text-white no-underline"
      href="/"
    >
      Voltar ao início
    </a>
  </main>
  <Footer />
</PublicLayout>
