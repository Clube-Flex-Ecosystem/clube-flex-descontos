---
import { AxiosError } from 'axios';
import {
  formatPhone,
  formatPostalCode,
  type PublicPartner,
} from '@flex/contracts';
import PublicLayout from '../../layouts/PublicLayout.astro';
import {
  ArrowLeft,
  ChevronDown,
  Info,
  MapPin,
  MessageSquare,
  Phone,
  Star,
} from '@lucide/astro';
import AssistantIsland from '../../features/assistant/components/AssistantIsland';
import {
  getPartner,
  listPlans,
} from '../../features/catalog/api/public-catalog';
const slug = Astro.params.slug!;
const plans = await listPlans().catch(() => []);
const planSlug = Astro.url.searchParams.get('plano') ?? undefined;
const selectedPlan = plans.find((p) => p.slug === planSlug);
let partner: PublicPartner | undefined;
try {
  partner = await getPartner(slug, selectedPlan?.id);
} catch (error) {
  if (error instanceof AxiosError && error.response?.status === 404)
    Astro.response.status = 404;
  else throw error;
}
if (partner && partner.slug !== slug)
  return Astro.redirect(
    `/parceiros/${partner.slug}${planSlug ? `?plano=${planSlug}` : ''}`,
    308,
  );
const back = `/?${planSlug ? `plano=${encodeURIComponent(planSlug)}&` : ''}#parceiros`;
const address = (u: PublicPartner['units'][number]) =>
  `${u.address.street}, ${u.address.number}${u.address.complement ? ` — ${u.address.complement}` : ''} · ${u.address.neighborhood}, ${u.address.city} — ${u.address.state} · CEP ${formatPostalCode(u.address.postalCode)}`;
const jsonLd = partner
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: partner.name,
      description: partner.description,
      url: Astro.url.href,
      ...(partner.website ? { sameAs: [partner.website] } : {}),
    }
  : undefined;
---

<PublicLayout
  title={
    partner
      ? `${partner.name} — Clube Flex`
      : 'Parceiro não encontrado — Clube Flex'
  }
  description={
    partner?.description ?? 'Este parceiro não está disponível no catálogo.'
  }
>
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
  <>
    {partner ? (
      <div class="mx-auto w-full max-w-[1200px] px-4 py-10 md:px-8 lg:py-16">
        <a
          class="mb-8 inline-flex items-center gap-2 font-semibold text-accent-foreground"
          href={back}
        >
          <ArrowLeft class="h-5 w-5" aria-hidden="true" stroke-width={1.75} />
          Voltar para parceiros
        </a>
        <header class="max-w-[760px]">
          <div class="flex flex-wrap gap-1.5">
            {partner.categories.map((c) => (
              <span class="inline-flex items-center rounded-full bg-surface-muted px-2.5 py-[3px] text-[13px] font-medium text-foreground-soft">
                {c.name}
              </span>
            ))}
            {partner.featured && (
              <span class="inline-flex items-center gap-1 rounded-full bg-primary px-2.5 py-[3px] text-[13px] font-medium text-background">
                <Star class="h-4 w-4" aria-hidden="true" stroke-width={1.75} />
                Destaque
              </span>
            )}
          </div>
          <h1 class="mt-4 font-display text-[clamp(36px,7vw,60px)] font-semibold leading-[1.08] tracking-[-0.02em]">
            {partner.name}
          </h1>
          <p class="mt-4 text-lg leading-[1.5] text-foreground-soft">
            {partner.description}
          </p>
        </header>
        <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
          <div class="grid gap-4">
            <section class="rounded-lg border border-border bg-background p-6">
              <h2>
                <Info
                  class="mr-2 inline h-5 w-5"
                  aria-hidden="true"
                  stroke-width={1.75}
                />
                Como usar o desconto
              </h2>
              <p>{partner.usageInstructions}</p>
            </section>
            {(partner.website || partner.contacts.length > 0) && (
              <section class="rounded-lg border border-border bg-background p-6">
                <h2>Contato</h2>
                {partner.website && (
                  <p class="website-row">
                    <a href={partner.website} target="_blank" rel="noopener">
                      {partner.website.replace(/^https?:\/\//, '')}
                    </a>
                    <a
                      class="inline-flex min-h-11 items-center justify-center rounded-full border-[1.5px] border-accent-foreground px-4 text-[15px] font-semibold text-accent-foreground"
                      href={partner.website}
                      target="_blank"
                      rel="noopener"
                    >
                      Abrir site
                    </a>
                  </p>
                )}
                <ul class="mt-4 grid gap-2">
                  {partner.contacts.map((c) => (
                    <li class="flex items-center gap-3 border-t border-border py-3">
                      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-surface-muted text-accent-foreground">
                        {c.type === 'whatsapp' ? (
                          <MessageSquare
                            class="h-5 w-5"
                            aria-hidden="true"
                            stroke-width={1.75}
                          />
                        ) : (
                          <Phone
                            class="h-5 w-5"
                            aria-hidden="true"
                            stroke-width={1.75}
                          />
                        )}
                      </span>
                      <div class="min-w-0 flex-1">
                        <small>
                          {c.label ??
                            (c.type === 'whatsapp' ? 'WhatsApp' : 'Telefone')}
                        </small>
                        <b>{formatPhone(c.value)}</b>
                      </div>
                      <a
                        class="inline-flex min-h-11 items-center justify-center rounded-full border-[1.5px] border-accent-foreground px-4 text-[15px] font-semibold text-accent-foreground"
                        href={
                          c.type === 'whatsapp'
                            ? `https://wa.me/${c.value.replace(/\D/g, '')}`
                            : `tel:${c.value}`
                        }
                      >
                        {c.type === 'whatsapp' ? 'WhatsApp' : 'Ligar'}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}
            <section class="rounded-lg border border-border bg-background p-6">
              <h2>
                {partner.units.length === 1
                  ? 'Unidade'
                  : `Unidades (${partner.units.length})`}
              </h2>
              {partner.units.length ? (
                <div class="mt-4 grid gap-2">
                  {partner.units.map((u, i) => (
                    <details
                      class="overflow-hidden rounded-lg border border-border"
                      open={i === 0 && partner!.units.length <= 2}
                    >
                      <summary>
                        <span class="grid h-9 w-9 place-items-center rounded-lg bg-surface-muted text-accent-foreground">
                          <MapPin
                            class="h-4 w-4"
                            aria-hidden="true"
                            stroke-width={1.75}
                          />
                        </span>
                        <span>
                          <b>{u.name}</b>
                          <small>
                            {u.address.neighborhood}, {u.address.city}
                          </small>
                        </span>
                        <ChevronDown
                          class="h-4 w-4"
                          aria-hidden="true"
                          stroke-width={1.75}
                        />
                      </summary>
                      <dl class="grid gap-3 border-t border-border p-4 text-sm">
                        <div>
                          <dt>Endereço</dt>
                          <dd>{address(u)}</dd>
                        </div>
                        {u.openingHours && (
                          <div>
                            <dt>Horário</dt>
                            <dd>{u.openingHours}</dd>
                          </div>
                        )}
                        {u.instructions && (
                          <div>
                            <dt>Instruções da unidade</dt>
                            <dd>{u.instructions}</dd>
                          </div>
                        )}
                      </dl>
                    </details>
                  ))}
                </div>
              ) : (
                <p class="text-foreground-soft">
                  Este parceiro não possui unidade física. Utilize os contatos
                  ou o site para usar o benefício.
                </p>
              )}
            </section>
            <section class="rounded-lg border border-border bg-background p-6">
              <h2>Ainda não é Flex?</h2>
              <p>
                Fale com o assistente virtual e deixe seus dados para conhecer
                os planos.
              </p>
              <div>
                <button
                  class="inline-flex min-h-11 items-center justify-center rounded-full bg-primary px-4 text-[15px] font-semibold text-white"
                  type="button"
                  data-open-assistant="flex"
                >
                  Vem ser Flex
                </button>
              </div>
            </section>
          </div>
          <aside>
            <section class="rounded-lg border border-border bg-background p-6 lg:sticky lg:top-24">
              <h2 class="sr-only">Benefício</h2>
              <form method="get" class="grid gap-1.5">
                <label for="partner-plan">Seu plano</label>
                <div class="relative">
                  <select
                    id="partner-plan"
                    name="plano"
                    onchange="this.form.submit()"
                  >
                    <option value="">Selecione seu plano</option>
                    {plans.map((p) => (
                      <option
                        value={p.slug}
                        selected={p.id === selectedPlan?.id}
                      >
                        {p.name}
                      </option>
                    ))}
                  </select>
                  <ChevronDown
                    class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2"
                    aria-hidden="true"
                    stroke-width={1.75}
                  />
                </div>
                <p class="text-sm text-muted-foreground">
                  Informado por você; não é validado pelo Clube Flex.
                </p>
              </form>
              {selectedPlan && partner.discountPercentage ? (
                <div class="mt-6">
                  <small>Seu desconto</small>
                  <strong>
                    <span>até</span>
                    {partner.discountPercentage}%
                  </strong>
                  {partner.coupon && (
                    <div class="mt-4 rounded-lg bg-accent-soft p-4 text-accent-foreground">
                      <div>
                        <small>Cupom</small>
                        <code>{partner.coupon}</code>
                      </div>
                    </div>
                  )}
                </div>
              ) : (
                <div class="mt-6 rounded-lg bg-surface-muted p-4 text-sm text-foreground-soft">
                  Escolha seu plano para consultar o desconto disponível.
                </div>
              )}
            </section>
          </aside>
        </div>
      </div>
    ) : (
      <div class="mx-auto grid min-h-[50vh] w-full max-w-[1200px] content-center gap-4 px-4 py-16 md:px-8">
        <h1 class="font-display text-4xl font-semibold">
          Parceiro não encontrado
        </h1>
        <p>Este parceiro não está disponível no catálogo.</p>
        <a
          class="inline-flex min-h-12 w-fit items-center justify-center rounded-full bg-primary px-[22px] font-semibold text-white no-underline"
          href="/#parceiros"
        >
          Ver parceiros
        </a>
      </div>
    )}
  </>
  <AssistantIsland client:load />
</PublicLayout>
