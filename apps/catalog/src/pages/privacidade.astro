---
import PublicLayout from '../layouts/PublicLayout.astro';
import { ArrowLeft } from '@lucide/astro';
---

<PublicLayout
    title="Privacidade — Clube Flex"
    description="Política de privacidade do Clube Flex."
>
    <div class="mx-auto w-full max-w-300 px-4 pt-8 pb-18 md:px-8">
        <div class="max-w-190">
            <a
                class="-ml-2 inline-flex min-h-11 items-center gap-1.5 rounded-control pr-3.5 pl-2 font-semibold text-foreground no-underline hover:bg-surface-muted"
                href="/"
            >
                <ArrowLeft
                    class="h-5 w-5"
                    aria-hidden="true"
                    stroke-width={1.75}
                />
                Voltar
            </a>
            <h1 class="mt-4 font-display text-display font-stretch-110%">
                Privacidade
            </h1>
            <p class="mt-4 text-foreground-soft">
                Espaço reservado para o texto de privacidade publicado. O
                conteúdo oficial ainda não foi fornecido.
            </p>
        </div>
    </div>
</PublicLayout>
