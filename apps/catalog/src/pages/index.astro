---
import PublicLayout from '../layouts/PublicLayout.astro';
import AssistantIsland from '../features/assistant/components/AssistantIsland';
import AboutSection from '../features/home/components/AboutSection.astro';
import CatalogSection from '../features/home/components/CatalogSection.astro';
import CategoryRibbon from '../features/home/components/CategoryRibbon.astro';
import HeroSection from '../features/home/components/HeroSection.astro';
import HowItWorksSection from '../features/home/components/HowItWorksSection.astro';
import {
    listCategories,
    listPartners,
    listPlans,
} from '../features/catalog/api/public-catalog';
import { ORGANIZATION, SITE_NAME } from '../shared/config/site';
const plans = await listPlans().catch(() => []);
const planSlug = Astro.url.searchParams.get('plano');
const categoryId = Astro.url.searchParams.get('categoria') ?? undefined;
const initialPlan = plans.find((p) => p.slug === planSlug);
const initialInvalid = Boolean(planSlug && !initialPlan);
const [initialCategories, initialPartners] = initialPlan
    ? await Promise.all([
          listCategories(initialPlan.id),
          listPartners(initialPlan.id, categoryId),
      ]).catch(() => [[], []])
    : [[], []];
const siteUrl = new URL('/', Astro.site).href;
const jsonLd = [
    {
        '@context': 'https://schema.org',
        '@type': 'Organization',
        '@id': `${siteUrl}#organization`,
        name: ORGANIZATION.name,
        url: siteUrl,
        telephone: ORGANIZATION.telephone,
        email: ORGANIZATION.email,
        address: { '@type': 'PostalAddress', ...ORGANIZATION.address },
    },
    {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        '@id': `${siteUrl}#website`,
        name: SITE_NAME,
        url: siteUrl,
        inLanguage: 'pt-BR',
        publisher: { '@id': `${siteUrl}#organization` },
    },
];
---

<PublicLayout
    title="Clube Flex | Benefícios e descontos exclusivos"
    description="Conheça os parceiros do Clube Flex e descubra benefícios, descontos e vantagens disponíveis para o seu plano."
    canonicalPath="/"
    jsonLd={jsonLd}
>
    <>
        <HeroSection />
        <CategoryRibbon />
        <AboutSection />
        <CatalogSection
            plans={plans}
            initialPlan={initialPlan}
            initialCategory={categoryId}
            initialCategories={initialCategories}
            initialPartners={initialPartners}
            initialInvalid={initialInvalid}
        />
        <HowItWorksSection />
    </>
    <AssistantIsland client:load />
</PublicLayout>
