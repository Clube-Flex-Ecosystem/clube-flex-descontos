{
  "name": "clube-flex",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:api": "pnpm --filter @flex/api dev",
    "dev:dashboard": "pnpm --filter @flex/dashboard dev",
    "dev:catalog": "pnpm --filter @flex/catalog dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d --wait db db-test",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
